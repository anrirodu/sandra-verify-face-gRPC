# ═══════════════════════════════════════════════════════════
# recognition-facial — Configuración del servicio gRPC
# Copia a .env y ajusta. TODO es configurable por variables
# de entorno (preceden a este archivo).
# ═══════════════════════════════════════════════════════════

# ─── Servidor gRPC ────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
GRPC_MAX_WORKERS=4          # hilos de inferencia (GPU → 1 recomendado)
GRPC_MAX_MESSAGE_MB=32      # tamaño máximo de imagen recibida

# ─── Inferencia ───────────────────────────────────────────
# Pesos YOLO para detección de rostros: yolov8n-face.pt
# (ver scripts/download_weights.sh). También acepta yolov8n.pt
# genérico filtrando la clase "persona".
DETECTOR_MODEL=models/yolov8n-face.pt
DETECTOR_CONF=0.40          # umbral confianza detección (0.0-1.0)
DETECTOR_IOU=0.45           # NMS IoU
DETECTOR_IMG_SIZE=640       # tamaño de entrada del modelo
DETECTOR_USE_GPU=true       # MPS/CUDA si disponible, si no CPU

# Modelo de embeddings InsightFace (rec.onnx, 512-d). Si es un
# nombre simple se busca en la carpeta de modelos de InsightFace.
EMBEDDER_MODEL=buffalo_l/rec.onnx
EMBEDDER_USE_GPU=true

# ─── Índice de rostros ────────────────────────────────────
INDEX_ENGINE=auto           # auto | faiss | numpy
INDEX_DIM=512               # dimensiones del embedding
INDEX_METRIC=cosine         # cosine | l2
INDEX_FILE=data/faces.index
INDEX_META=data/faces.ndjson
MATCH_THRESHOLD=0.50        # similitud mínima para considerar match

# ─── Misc ─────────────────────────────────────────────────
LOG_LEVEL=INFO
SERVICE_NAME=recognition-facial
SERVICE_VERSION=0.1.0